urly_air_quality\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-12T01:40:10.137633Z", "completed_at": "2026-10-12T01:40:10.141428Z"}, {"name": "execute", "started_at": "2026-10-12T01:40:10.143540Z", "completed_at": "2026-10-12T01:40:10.217023Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.09097886085510254, "adapter_response": {"_message": "SELECT 10080", "code": "SELECT", "rows_affected": 10080}, "message": "SELECT 10080", "failures": null, "unique_id": "model.vietnam_air_quality.fact_weather_hourly", "compiled": true, "compiled_code": "SELECT * FROM \"vietnam_air_quality\".\"analytics_staging\".\"stg_weather\"", "relation_name": "\"vietnam_air_quality\".\"analytics_analytics\".\"fact_weather_hourly\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-12T01:40:10.223487Z", "completed_at": "2026-10-12T01:40:10.227764Z"}, {"name": "execute", "started_at": "2026-10-12T01:40:10.228167Z", "completed_at": "2026-10-12T01:40:10.248178Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.02837395668029785, "adapter_response": {"_message": "CREATE VIEW", "code": "CREATE VIEW", "rows_affected": -1}, "message": "CREATE VIEW", "failures": null, "unique_id": "model.vietnam_air_quality.int_air_quality_weather", "compiled": true, "compiled_code": "WITH air_quality AS (\n    SELECT * FROM \"vietnam_air_quality\".\"analytics_intermediate\".\"int_hourly_air_quality\"\n),\n\nweather AS (\n    SELECT * FROM \"vietnam_air_quality\".\"analytics_staging\".\"stg_weather\"\n),\n\njoined AS (\n    SELECT\n        aq.timestamp_utc,\n        aq.city,\n        aq.location_id,\n        aq.location_name,\n        aq.sensor_id,\n        aq.pm25,\n        aq.pm10,\n        aq.pm25_unit,\n        aq.pm10_unit,\n        wx.temperature,\n        wx.relative_humidity,\n        wx.precipitation,\n        wx.wind_speed,\n        wx.wind_direction,\n        wx.surface_pressure\n    FROM air_quality aq\n    LEFT JOIN weather wx\n        ON aq.city = wx.city\n        AND aq.timestamp_utc = wx.timestamp\n)\n\nSELECT * FROM joined", "relation_name": "\"vietnam_air_quality\".\"analytics_intermediate\".\"int_air_quality_weather\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-12T01:40:10.221850Z", "completed_at": "2026-10-12T01:40:10.225750Z"}, {"name": "execute", "started_at": "2026-10-12T01:40:10.226003Z", "completed_at": "2026-10-12T01:40:10.285292Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.06642508506774902, "adapter_response": {"_message": "SELECT 1192", "code": "SELECT", "rows_affected": 1192}, "message": "SELECT 1192", "failures": null, "unique_id": "model.vietnam_air_quality.fact_air_quality_hourly", "compiled": true, "compiled_code": "SELECT * FROM \"vietnam_air_quality\".\"analytics_intermediate\".\"int_hourly_air_quality\"", "relation_name": "\"vietnam_air_quality\".\"analytics_analytics\".\"fact_air_quality_hourly\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-12T01:40:10.259056Z", "completed_at": "2026-10-12T01:40:10.262803Z"}, {"name": "execute", "started_at": "2026-10-12T01:40:10.265008Z", "completed_at": "2026-10-12T01:40:10.341218Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.0867607593536377, "adapter_response": {"_message": "SELECT 27", "code": "SELECT", "rows_affected": 27}, "message": "SELECT 27", "failures": null, "unique_id": "model.vietnam_air_quality.mart_city_daily", "compiled": true, "compiled_code": "WITH hourly AS (\n    SELECT * FROM \"vietnam_air_quality\".\"analytics_intermediate\".\"int_air_quality_weather\"\n),\n\ndaily AS (\n    SELECT\n        city,\n        DATE(timestamp_utc) AS date,\n        AVG(pm25) AS avg_pm25,\n        AVG(pm10) AS avg_pm10,\n        MAX(pm25) AS max_pm25,\n        MAX(pm10) AS max_pm10,\n        AVG(temperature) AS avg_temperature,\n        AVG(relative_humidity) AS avg_humidity,\n        AVG(wind_speed) AS avg_wind_speed,\n        SUM(precipitation) AS total_precipitation,\n        COUNT(*) AS record_count\n    FROM hourly\n    GROUP BY city, DATE(timestamp_utc)\n)\n\nSELECT * FROM daily", "relation_name": "\"vietnam_air_quality\".\"analytics_analytics\".\"mart_city_daily\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-12T01:40:10.260949Z", "completed_at": "2026-10-12T01:40:10.264698Z"}, {"name": "execute", "started_at": "2026-10-12T01:40:10.268412Z", "completed_at": "2026-10-12T01:40:10.344697Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.08744311332702637, "adapter_response": {"_message": "SELECT 18594", "code": "SELECT", "rows_affected": 18594}, "message": "SELECT 18594", "failures": null, "unique_id": "model.vietnam_air_quality.mart_pollution_weather", "compiled": true, "compiled_code": "WITH joined AS (\n    SELECT * FROM \"vietnam_air_quality\".\"analytics_intermediate\".\"int_air_quality_weather\"\n),\n\nclassified AS (\n    SELECT\n        *,\n        CASE\n            WHEN pm25 <= 12 THEN 'Good'\n            WHEN pm25 <= 35.4 THEN 'Moderate'\n            WHEN pm25 <= 55.4 THEN 'Unhealthy for Sensitive Groups'\n            WHEN pm25 <= 150.4 THEN 'Unhealthy'\n            WHEN pm25 <= 250.4 THEN 'Very Unhealthy'\n            ELSE 'Hazardous'\n        END AS pollution_level\n    FROM joined\n)\n\nSELECT * FROM classified", "relation_name": "\"vietnam_air_quality\".\"analytics_analytics\".\"mart_pollution_weather\"", "batch_results": null, "overload_results": null}], "elapsed_time": 0.550048828125, "args": {"partial_parse": true, "quiet": false, "require_ref_searches_node_package_before_root": false, "macro_debugging": false, "source_freshness_run_project_hooks": true, "upload_to_artifacts_ingest_api": false,