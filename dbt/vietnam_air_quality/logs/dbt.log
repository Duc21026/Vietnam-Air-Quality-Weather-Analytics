  create  table "vietnam_air_quality"."analytics_analytics"."mart_pollution_weather__dbt_tmp"
  
  
    as
  
  (
    WITH joined AS (
    SELECT * FROM "vietnam_air_quality"."analytics_intermediate"."int_air_quality_weather"
),

classified AS (
    SELECT
        *,
        CASE
            WHEN pm25 <= 12 THEN 'Good'
            WHEN pm25 <= 35.4 THEN 'Moderate'
            WHEN pm25 <= 55.4 THEN 'Unhealthy for Sensitive Groups'
            WHEN pm25 <= 150.4 THEN 'Unhealthy'
            WHEN pm25 <= 250.4 THEN 'Very Unhealthy'
            ELSE 'Hazardous'
        END AS pollution_level
    FROM joined
)

SELECT * FROM classified
  );
  
[0m15:06:35.015838 [debug] [Thread-3 (]: Opening a new connection, currently in state closed
[0m15:06:35.015479 [debug] [Thread-4 (]: Using postgres connection "model.vietnam_air_quality.mart_city_daily"
[0m15:06:35.016500 [debug] [Thread-4 (]: On model.vietnam_air_quality.mart_city_daily: /* {"app": "dbt", "dbt_version": "1.12.5", "profile_name": "vietnam_air_quality", "target_name": "dev", "node_id": "model.vietnam_air_quality.mart_city_daily"} */

  
    

  create  table "vietnam_air_quality"."analytics_analytics"."mart_city_daily__dbt_tmp"
  
  
    as
  
  (
    WITH hourly AS (
    SELECT * FROM "vietnam_air_quality"."analytics_intermediate"."int_air_quality_weather"
),

daily AS (
    SELECT
        city,
        DATE(timestamp_utc) AS date,
        AVG(pm25) AS avg_pm25,
        AVG(pm10) AS avg_pm10,
        MAX(pm25) AS max_pm25,
        MAX(pm10) AS max_pm10,
        AVG(temperature) AS avg_temperature,
        AVG(relative_humidity) AS avg_humidity,
        AVG(wind_speed) AS avg_wind_speed,
        SUM(precipitation) AS total_precipitation,
        COUNT(*) AS record_count
    FROM hourly
    GROUP BY city, DATE(timestamp_utc)
)

SELECT * FROM daily
  );
  
