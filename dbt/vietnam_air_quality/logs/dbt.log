  create view "vietnam_air_quality"."analytics_intermediate"."int_air_quality_weather__dbt_tmp"
    
    
  as (
    WITH air_quality AS (
    SELECT * FROM "vietnam_air_quality"."analytics_intermediate"."int_hourly_air_quality"
),

weather AS (
