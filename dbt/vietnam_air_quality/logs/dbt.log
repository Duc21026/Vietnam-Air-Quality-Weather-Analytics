        aq.pm10_unit,
        wx.temperature,
        wx.relative_humidity,
        wx.precipitation,
        wx.wind_speed,
        wx.wind_direction,
        wx.surface_pressure
    FROM air_quality aq
    LEFT JOIN weather wx
        ON aq.city = wx.city
        AND aq.timestamp_utc = wx.timestamp
)

