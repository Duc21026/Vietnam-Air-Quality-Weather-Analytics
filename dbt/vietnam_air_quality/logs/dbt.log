  create view "vietnam_air_quality"."analytics_intermediate"."int_air_quality_weather__dbt_tmp"
    
    
  as (
    WITH air_quality AS (
    SELECT * FROM "vietnam_air_quality"."analytics_intermediate"."int_hourly_air_quality"
),

weather AS (
    SELECT * FROM "vietnam_air_quality"."analytics_staging"."stg_weather"
),

joined AS (
    SELECT
        aq.timestamp_utc,
        aq.city,
        aq.location_id,
        aq.location_name,
        aq.sensor_id,
        aq.pm25,
        aq.pm10,
        aq.pm25_unit,
        aq.pm10_unit,
        wx.temperature,
        wx.relative_humidity,
        wx.precipitation,
        wx.wind_speed,
        wx.wind_direction,
        wx.surface_pressure
    FROM air_quality aq
    LEFT JOIN weather wx
        ON aq.city = wx.city
        AND aq.timestamp_utc = wx.timestamp
)

SELECT * FROM joined
  );
[0m07:17:53.453125 [debug] [Thread-4 (]: On model.vietnam_air_quality.mart_city_pm25_comparison: /* {"app": "dbt", "dbt_version": "1.12.5", "profile_name": "vietnam_air_quality", "target_name": "dev", "node_id": "model.vietnam_air_quality.mart_city_pm25_comparison"} */

  
    

  create  table "vietnam_air_quality"."analytics_analytics"."mart_city_pm25_comparison__dbt_tmp"
  
  
    as
  
  (
    WITH station_daily AS (
    SELECT
        city,
        sensor_id,
        DATE(timestamp_utc) AS date,
        AVG(pm25) AS station_avg_pm25,
        COUNT(*) AS station_measurement_count
    FROM "vietnam_air_quality"."analytics_intermediate"."int_hourly_air_quality"
    WHERE pm25 IS NOT NULL
    GROUP BY city, sensor_id, DATE(timestamp_utc)
),

city_daily AS (
    SELECT
        city,
        date,
        AVG(station_avg_pm25) AS avg_pm25,
        COUNT(*) AS station_count,
        SUM(station_measurement_count) AS measurement_count,
        MIN(station_avg_pm25) AS min_station_pm25,
        MAX(station_avg_pm25) AS max_station_pm25
    FROM station_daily
    GROUP BY city, date
)

SELECT * FROM city_daily
  );
  
